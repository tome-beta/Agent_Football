{
  "name": "soccer-sim",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "3vs3 soccer simulation game in TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "headless": "tsx src/headless.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.1.0",
    "tsx": "^4.7.0"
  }
}
